# Copy to apps/pipeline/.env (optional). Every setting is optional. Empty keys are off; commented
# keys show the default (an empty value is not the same as unset, so uncomment to change one).
# `make pipeline` and `docker compose run pipeline` pass this whole file to the pipeline. A bare
# `uv run atlas-pipeline` reads only the first block from it; export the others or use
# `uv run --env-file .env atlas-pipeline ...`.
# Sign in with ChatGPT settings (issuer, API base URL, models) come from apps/backend/.env.

# --- database and tools (read from this file by every entry point) ------------------------
# Postgres as atlas_pipeline: staging schema + graph tables, no access to user tables.
# Ignored by `docker compose run pipeline`, which connects to the compose `db` service.
PIPELINE_DATABASE_URL=postgresql://atlas_pipeline:atlas_pipeline@localhost:5432/atlas
# psql used by the load stage (\copy); on Linux usually /usr/bin/psql (the image sets it).
# PSQL_BIN=/opt/homebrew/bin/psql
# NCBI E-utilities key: PubMed at 10 instead of 3 requests per second.
NCBI_API_KEY=
# OMIM key: enables the optional omim source (genemap2, morbidmap).
OMIM_API_KEY=
# Bright Data key: with BRIGHTDATA_SERP_ZONE, web search for more patient organizations.
BRIGHTDATA_API_KEY=
# Contact address in the User-Agent and the NCBI email parameter.
# CONTACT_EMAIL=atlas-pipeline@example.org
# HTTP timeout in seconds and retries per request.
# HTTP_TIMEOUT=60
# HTTP_RETRIES=5
# Default requests per second for sources without their own rate.
# DEFAULT_RATE=5
# Per-source rates as JSON, e.g. {"pubmed": 3.0, "reporter": 1.0}.
# RATES={"pubmed": 3.0, "reporter": 1.0, "clinicaltrials": 5.0, "patient_orgs": 2.0, "omim": 2.0}
# Days before cached API responses are fetched again (bulk files are cached as files).
# CACHE_TTL_DAYS=30
# Parallel model calls in the LLM steps.
# LLM_CONCURRENCY=8
# Keep a researcher only with at least this many links (papers, grants, trials).
# RESEARCHER_MIN_LINKS=2

# --- Bright Data (environment only) ---------------------------------------------------------
# SERP zone name for the patient organization search (needs BRIGHTDATA_API_KEY).
BRIGHTDATA_SERP_ZONE=
# Search results kept per query.
# BRIGHTDATA_MAX_RESULTS_PER_QUERY=5

# --- LLM budget (environment only) ----------------------------------------------------------
# Uncached model calls per run; cache hits are free.
# PIPELINE_LLM_MAX_CALLS=300
# true = skip every model call even when signed in.
# PIPELINE_LLM_DISABLED=false

# --- literature and registry caps (environment only) ----------------------------------------
# PubMed abstracts per seed gene / other gene / seed disease / other disease.
# PUBMED_MAX_PER_SEED_GENE=40
# PUBMED_MAX_PER_GENE=5
# PUBMED_MAX_PER_SEED_DISEASE=20
# PUBMED_MAX_PER_DISEASE=5
# Share of review articles among the PubMed results.
# PUBMED_REVIEW_SHARE=0.25
# Extra PubMed term that keeps gene searches on the cluster's phenotype; empty disables it.
# PUBMED_GENE_CONTEXT="(epilep*[tiab] OR seizure*[tiab] OR encephalopath*[tiab] OR neurodevelopment*[tiab])"
# ClinicalTrials.gov studies per seed gene / other gene / seed disease / other disease.
# CLINICALTRIALS_MAX_PER_SEED_GENE=50
# CLINICALTRIALS_MAX_PER_GENE=10
# CLINICALTRIALS_MAX_PER_SEED_DISEASE=100
# CLINICALTRIALS_MAX_PER_DISEASE=10
# NIH RePORTER grants per seed term / other term.
# REPORTER_MAX_PER_SEED_TERM=100
# REPORTER_MAX_PER_TERM=10

# --- local files (environment only; leave unset for Docker, which mounts both) --------
# ChatGPT login file of `atlas-pipeline login`.
# AMBER_OPENAI_CREDENTIALS=~/.config/amber/openai.json
# fastembed model cache.
# FASTEMBED_CACHE_DIR=~/.cache/amber/fastembed
