# Copy to apps/backend/.env (`make setup` does this and fills the generated secrets).
# Browser-facing URLs always use 127.0.0.1, never localhost.

# --- database (local docker compose, dev passwords = role names) --------------------------
# API connects as atlas_app: not owner, no BYPASSRLS, RLS on every user table.
DATABASE_URL=postgresql+asyncpg://atlas_app:atlas_app@localhost:5432/atlas
# Alembic runs as the schema owner.
MIGRATION_DATABASE_URL=postgresql+psycopg://atlas_owner:atlas_owner@localhost:5432/atlas
# Ingestion pipeline and fixture loader: staging schema + graph tables, no user tables.
PIPELINE_DATABASE_URL=postgresql://atlas_pipeline:atlas_pipeline@localhost:5432/atlas
# Superuser, only for bootstrap and the test harness (creates throwaway databases).
BOOTSTRAP_DATABASE_URL=postgresql://atlas:atlas@localhost:5432/postgres

# --- API --------------------------------------------------------------------------------
# HS256 secret for the amber_session cookie JWT (generated by `make setup`).
SESSION_SECRET=
# Allowed CORS origin (credentials enabled) and where redirects go back to.
FRONTEND_URL=http://127.0.0.1:3100
# Optional extra CORS origins as a regex, for running several frontend dev servers side by side.
# CORS_EXTRA_ORIGIN_REGEX='^http://127\.0\.0\.1:31\d\d$'
API_URL=http://127.0.0.1:8000
# Set true behind HTTPS.
COOKIE_SECURE=false
# Demo mode flag exposed by GET /auth/session.
DEMO_MODE=false

# --- Sign in with ChatGPT / OpenAI (read by backend.openai_auth) ----------------------------
OPENAI_AUTH_ISSUER=https://auth.openai.com
OPENAI_API_BASE_URL=https://api.openai.com/v1
# Empty = dynamic client registration (open-source / locally hosted flow).
OPENAI_CLIENT_ID=
OPENAI_CLIENT_SECRET=
OPENAI_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
OPENAI_AGENT_NAME=Amber Rare Disease Atlas
# urn:uuid:<uuid4>, generated by `make setup`.
OPENAI_AGENT_HOST_ID=
# Empty = the platform module's defaults.
OPENAI_MODEL_MAIN=
OPENAI_MODEL_SMALL=
# Fernet key for openai_tokens (generated by `make setup`).
TOKEN_ENCRYPTION_KEY=

# --- Server OpenAI API key and Sign in with Google (both off by default) ---------------------
# OPENAI_API_KEY: the operator's API key. Model calls of accounts without their own ChatGPT sign-in
# (Google accounts) run on it and are billed to the operator. ChatGPT accounts keep using their plan.
OPENAI_API_KEY=
# Models for the API-key path only (the ChatGPT-plan list and OPENAI_MODEL_* do not apply).
OPENAI_API_MODEL_MAIN=gpt-5
OPENAI_API_MODEL_SMALL=gpt-5-mini
# Google sign-in is offered only when GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are set AND
# (OPENAI_API_KEY is set OR GOOGLE_LOGIN_ENABLED=true). Without a server key, Google accounts get
# everything except Dr. Wu and other model features.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_LOGIN_ENABLED=false
# Empty = <API_URL>/auth/google/callback; register exactly this URI in the Google Cloud console.
GOOGLE_REDIRECT_URI=
# Fernet key(s) for message bodies, comma-separated, newest first (rotate with
# `uv run python -m backend.cli rotate-message-key`). Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Empty: a key derived from SESSION_SECRET on loopback only (demo); elsewhere messaging is off.
MESSAGE_ENCRYPTION_KEY=

# --- local embeddings (fastembed) -------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- observability (optional, self-hosted Langfuse; empty = off) ----------------------------
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- optional data source keys (pipeline; empty = off) --------------------------------------
BRIGHT_DATA_API_KEY=
# Bright Data SERP zone; with the key above it enables the gap-search agent's web_search tool.
BRIGHTDATA_SERP_ZONE=
OMIM_API_KEY=
NCBI_API_KEY=
